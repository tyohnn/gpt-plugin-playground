{
    "name": "host-playground",
    "version": "0.1.0",
    "description": "ChatGPT 호스트를 흉내 내 MCP 플러그인을 실물 없이 끝까지 돌린다",
    "type": "module",
    "bin": {
        "host-playground": "dist/cli.js"
    },
    "exports": {
        ".": "./dist/server.js",
        "./playwright": "./dist/playwright.js"
    },
    "files": ["dist"],
    "scripts": {
        "build": "node build.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "e2e": "playwright test"
    },
    "dependencies": {},
    "devDependencies": {
        "@host-playground/core": "*",
        "@host-playground/shell": "*",
        "@playwright/test": "^1.56.0",
        "@types/node": "^22.0.0",
        "esbuild": "^0.25.0"
    },
    "peerDependencies": {
        "@playwright/test": ">=1.50"
    },
    "peerDependenciesMeta": {
        "@playwright/test": { "optional": true }
    }
}
