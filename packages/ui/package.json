{
    "name": "@host-playground/ui",
    "version": "0.0.0",
    "private": true,
    "description": "shadcn components on Base UI primitives with tyohnn design systems: one set of TSX, one CSS folder per system.",
    "exports": {
        "./components/*": "./src/components/*.tsx",
        "./hooks/*": "./src/hooks/*.ts",
        "./lib/*": "./src/lib/*.ts",
        "./blocks/*": "./src/blocks/*.tsx",
        "./blocks/lib/*": "./src/blocks/lib/*.ts",
        "./icons": "./src/icons/index.ts",
        "./icons/names": "./src/icons/names.ts",
        "./strings": "./src/strings/index.ts",
        "./systems/*": "./src/systems/*"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@hugeicons/core-free-icons": "^4.3.3",
        "@hugeicons/react": "^1.1.10",
        "@shadcn/react": "^0.3.1",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "0.2.5",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "react": "^19.2.1",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.1",
        "react-resizable-panels": "^4.12.3",
        "recharts": "3.8.0",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
